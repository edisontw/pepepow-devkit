{
  "name": "@pepepow/pepew-js",
  "version": "0.1.0",
  "private": false,
  "description": "PEPEW protocol utilities for Payment URI parsing, serialization, address validation and amount handling.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bs58check": "^4.0.0"
  },
  "devDependencies": {
    "@types/bs58check": "^2.1.1",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edisontw/pepepow-devkit.git",
    "directory": "packages/pepew-js"
  },
  "homepage": "https://github.com/edisontw/pepepow-devkit/tree/main/packages/pepew-js",
  "bugs": {
    "url": "https://github.com/edisontw/pepepow-devkit/issues"
  },
  "keywords": [
    "pepepow",
    "pepew",
    "payment-uri",
    "payments",
    "blockchain"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
