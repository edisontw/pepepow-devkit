# Server-side only. Install as /etc/pepew-bots/telegram.env mode 0640 root:pepew-bot.
TELEGRAM_BOT_TOKEN=replace_me
PEPEW_MERCHANT_API_KEY=replace_with_telegram_scoped_credential
