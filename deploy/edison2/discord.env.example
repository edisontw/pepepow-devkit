# Server-side only. Install as /etc/pepew-bots/discord.env mode 0640 root:pepew-bot.
DISCORD_PUBLIC_KEY=replace_with_public_key
DISCORD_APPLICATION_ID=replace_with_application_id
DISCORD_GUILD_ID=replace_with_server_id
DISCORD_BOT_TOKEN=replace_me
PEPEW_MERCHANT_API_KEY=replace_with_discord_scoped_credential
PEPEW_PAYMENT_API_ORIGIN=https://pay.pepepow.net
PEPEW_CHECKOUT_BASE_URL=https://pay.pepepow.net/
PEPEW_CONFIRMATIONS=1
PEPEW_EXPIRES_IN=900
