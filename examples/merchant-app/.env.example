# Merchant backend only. Never expose these values to browser JavaScript.
PEPEW_MERCHANT_API_KEY=replace_me
PEPEW_WEBHOOK_SIGNING_SECRET=replace_me

# Public receiving address used when the backend creates a payment.
PEPEW_RECEIVE_ADDRESS=replace_with_merchant_address

# Optional overrides.
PEPEW_PAYMENT_API_ORIGIN=https://pay.pepepow.net
PEPEW_CHECKOUT_BASE_URL=https://pay.pepepow.net/
PEPEW_CONFIRMATIONS=3
PEPEW_EXPIRES_IN=900
MERCHANT_DB_PATH=./data/merchant.sqlite3
HOST=127.0.0.1
PORT=3000
